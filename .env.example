# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Authentication & JWT
# REQUIRED. Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=30d

# Arcjet Security & Rate Limiting
ARCJET_KEY=ajkey_your_arcjet_api_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="aljo chat <no-reply@aljochat.com>"

# Mediasoup SFU (group calls)
# The SFU needs the UDP (and TCP) port range below reachable from the internet.
MEDIASOUP_LISTEN_IP=0.0.0.0
# REQUIRED in any deployed environment: the public IP clients connect to
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100
# Workers (one per CPU core by default, max 4). All workers share the port range above.
MEDIASOUP_NUM_WORKERS=

# ICE / TURN (needed for calls behind strict NATs and mobile networks)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
# Preferred: coturn static-auth-secret (short-lived credentials are minted per user)
TURN_STATIC_AUTH_SECRET=
# Or static credentials from a managed TURN provider
TURN_USERNAME=
TURN_CREDENTIAL=

# File storage: when Cloudinary is not configured, uploads are stored here (development)
UPLOAD_DIR=uploads
