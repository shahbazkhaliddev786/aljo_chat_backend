# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Authentication & JWT
JWT_SECRET=super-secret-access-token-key-aljo-chat
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super-secret-refresh-token-key-aljo-chat
REFRESH_TOKEN_EXPIRES_IN=30d

# Arcjet Security & Rate Limiting
ARCJET_KEY=ajkey_your_arcjet_api_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="aljo chat <no-reply@aljochat.com>"
